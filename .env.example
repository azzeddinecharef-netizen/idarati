# ==============================================================================
# IDARATI Company - Railway & Server Environment Variables
# ==============================================================================

# 1) Database Configuration (Automatically provided by Railway when you add PostgreSQL plugin)
# مثال: postgresql://postgres:password@postgres.railway.internal:5432/railway
DATABASE_URL=

# 2) Server Port (Automatically set by Railway)
PORT=3000

# 3) Meta Pixel & Conversions API (CAPI)
# رقم بيكسل ميتا / فيسبوك
FB_PIXEL_ID=1446779740729835

# توكن الوصول لتتبع السيرفر المباشر CAPI (من Meta Events Manager -> Settings -> Generate Access Token)
# اتركه فارغاً إذا كنت تكتفي بالتتبع من المتصفح (Browser Pixel)
FB_ACCESS_TOKEN=

# 4) Google Sheets Sync (نسخة احتياطية متزامنة)
# رابط Google Apps Script Web App
SHEET_URL=https://script.google.com/macros/s/AKfycbxk3HUf8-62n7iHGxgmO7UgfasDRSmsMjRmSHoLO5kgBxFOAVU_LOw6NvJELw8C7Rck/exec

# 5) Contact Details (اختياري لتغيير الأرقام دون تعديل الكود)
WHATSAPP=213770345869
PHONE=+213773345816
